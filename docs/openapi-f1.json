          "message_id",
          "text"
        ],
        "title": "MessageRequest"
      },
      "ProposalRequest": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Message Id"
          },
          "action_type": {
            "type": "string",
            "enum": [
