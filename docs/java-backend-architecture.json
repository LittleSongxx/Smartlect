  "cards": [
    {
      "dot": "cyan", "title": "入口与代码分层",
      "items": [
        "Gateway 分流用户、管理与 Assistant API；Redis 验会话。",
        "服务内验 /internal 令牌；各领域使用独立 MySQL schema。"
      ]
    },
    {
      "dot": "emerald", "title": "同步交易与数据边界",
      "items": [
        "Order 经 Feign 读取地址/商品，再锁券、扣库存、清购物车、建支付。",
        "Seata AT 由 Order 发起；券、库存、购物车、支付服务参与。"
      ]
    },
    {
      "dot": "amber", "title": "异步与外部边界",
      "items": [
        "RabbitMQ：TTL / DLX 管超时与自动收货；另投递会员成长。",
        "退款 Saga：Pay 退款 → Stock 回补 → Order 回执；Outbox 重试。"
      ]
    }
  ]
