  "cards": [
    {
      "dot": "cyan",
      "title": "幂等账本",
      "items": [
        "唯一键 (user_id, command_type, idempotency_key) + SHA-256 请求指纹",
        "同键不同参 → 409；PROCESSING 超时转 INCONCLUSIVE 交人工核",
        "COMPLETED 直接回放已存响应并标 Idempotency-Replayed"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨服务扣减",
      "items": [
        "库存条件 UPDATE（stock + delta >= 0）从 SQL 层保证不超卖",
        "changeStockBatch 以业务键去重（stock_change_record 主键）",
        "券预占同样走条件扣减 + 幂等回补带库存上限"
      ]
    },
    {
      "dot": "amber",
      "title": "本地事务 + Outbox",
      "items": [
        "订单、明细、物流与 Outbox 行同库同事务落盘",
        "提交后再投递（Publisher Confirm），失败指数退避",
        "重试耗尽转 EXHAUSTED，Prometheus 指标 + 人工重放入口"
      ]
    },
    {
      "dot": "rose",
      "title": "失败补偿",
      "items": [
        "catch 分支回补库存、解锁券，均以幂等业务键保护",
        "回补再失败落 mq_compensation_log，自动重放 + 管理端人工重放",
        "补偿与业务同键，重放不会重复加减"
      ]
    }
  ]
}