  "cards": [
    {
      "dot": "cyan",
      "title": "为什么是 Outbox",
      "items": [
        "移除了 Seata：跨服务一致性=本地事务 + 本地消息表",
        "事件与业务同事务落库，提交后才投递，断开 pay→order 同步环",
        "投递带幂等键，重放由消费者去重"
      ]
    },
    {
      "dot": "amber",
      "title": "投递可靠性",
      "items": [
        "租约抢占 + Publisher Confirm，失败指数退避",
        "定时任务兜底扫描待投递（默认 5s 间隔）",
        "重试耗尽转 EXHAUSTED 并暴露 Prometheus 指标"
      ]
    },
    {
      "dot": "emerald",
      "title": "消费幂等",
      "items": [
        "Redis 租约 Lua 拦截重复消费",
        "单号粒度的 Redisson 锁，事务提交后才释放",
        "状态机 CAS 保证只推进一次"
      ]
    },
    {
      "dot": "rose",
      "title": "补偿与人工",
      "items": [
        "补偿台账 mq_compensation_log 记录四类远程失败",
        "自动重放 + 管理端台账页人工重放",
        "退款回购走 REFUND_EXCHANGE 独立队列"
      ]
    }
  ]
}