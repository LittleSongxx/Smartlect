  "cards": [
    {
      "dot": "cyan",
      "title": "两层校验",
      "items": [
        "网关直读 Redis 的 token 键判断登录态，不依赖共享库",
        "转发前剥离客户端伪造的 X-User-Id 等身份头",
        "服务端 Sa-Token 会话内省取得身份，注解兜底"
      ]
    },
    {
      "dot": "amber",
      "title": "双账号体系",
      "items": [
        "用户端 token（StpUtil）与管理端 adminToken（StpAdminLogic）互不通用",
        "管理端登录有 IP 锁定与失败计数，验证码校验先行",
        "密码 bcrypt 校验并支持自动升级"
      ]
    },
    {
      "dot": "emerald",
      "title": "白名单与内部接口",
      "items": [
        "登录 / 验证码 / 公开商品 / 导购路径不校验登录态",
        "/internal/** 只认 X-Internal-Token（常量时间比较，未配置即全拒）",
        "Feign 调用自动携带内部令牌头"
      ]
    },
    {
      "dot": "rose",
      "title": "网关限流",
      "items": [
        "Spring Cloud Gateway + Sentinel 按 routeId 限流",
        "敏感路径 30 QPS、默认 200 QPS，超限 429",
        "GET 请求默认重试 2 次"
      ]
    }
  ]
