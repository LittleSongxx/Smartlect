  "cards": [
    {
      "dot": "cyan",
      "title": "两段式防超发",
      "items": [
        "Redis Lua 预占是资格来源：库存、去重、参与者集合一次原子完成",
        "DB 侧条件 UPDATE 兜底（total_count=0 视为不限量）",
        "任一步失败释放预占，Redis 与 DB 由对账收敛"
      ]
    },
    {
      "dot": "amber",
      "title": "限流与幂等",
      "items": [
        "用户维度 30 次/60s、券维度 200 次/秒",
        "幂等命令键与请求指纹防重复抢购",
        "Redis 判重先行，DB 唯一约束兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "对账收敛",
      "items": [
        "每 10 分钟以 DB 为准覆盖 Redis 库存（锁 TTL 9 分钟）",
        "摘除悬空参与者集合成员",
        "Redis 归零时从 DB 权威同步"
      ]
    },
    {
      "dot": "rose",
      "title": "券的生命周期",
      "items": [
        "建单时券为 CANT（不可用），支付成功后才激活",
        "支付超时关单会回补库存与券名额",
        "回补带上限防止重复回补导致虚高"
      ]
    }
  ]
