  "cards": [
    {
      "dot": "cyan",
      "title": "唯一落库路径",
      "items": [
        "所有流转经 OrderStateMachine.transition 的 CAS 条件更新",
        "返回 0 行即并发竞争，幂等重入退化为读比对",
        "非法流转直接抛异常，不做静默修正"
      ]
    },
    {
      "dot": "amber",
      "title": "事件驱动",
      "items": [
        "支付成功由 pay 的 Outbox 事件推进（PAY_SUCCESS_QUEUE）",
        "延迟队列驱动支付超时关单、自动确认收货与模拟发货",
        "秒杀券支付成功直达 COMPLETED"
      ]
    },
    {
      "dot": "rose",
      "title": "退款 Saga",
      "items": [
        "退款走显式状态机：PENDING_PAYMENT → PAYMENT_CONFIRMED → STOCK_PENDING → COMPLETED",
        "库存回补失败可重试 6 次（60s 间隔），超限转 MANUAL_REVIEW",
        "部分退款可继续补退至全额"
      ]
    },
    {
      "dot": "slate",
      "title": "删除语义",
      "items": [
        "DELETE(-1) 是软删除标记，只有终态可进入",
        "用户删除与系统关单分开表达",
        "已删除订单不再参与对账统计"
      ]
    }
  ]
