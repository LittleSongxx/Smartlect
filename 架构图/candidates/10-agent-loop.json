  "cards": [
    {
      "dot": "cyan",
      "title": "一个有界循环",
      "items": [
        "LangGraph 图只编译一次：model → tools → answer",
        "run 作用域经 ContextVar 注入，无跨轮状态",
        "预算是单一事实源：模型 6 次、工具 10 次、检索 2 次、单轮 90s"
      ]
    },
    {
      "dot": "amber",
      "title": "工具调用纪律",
      "items": [
        "allowed 列表 + RBAC + 严格 Pydantic 校验三层放行",
        "MySQL 工具调用账本：重复调用直接回放回执",
        "单条观察 6500 字节上限，超限转 result_too_large"
      ]
    },
    {
      "dot": "emerald",
      "title": "答案守卫链",
      "items": [
        "证据契约：无观测不得下结论，SKU 必须绑定观测",
        "状态声明必须带本轮回执（订单/券/积分）",
        "引用在出答前复验仍可见，否则降级或拒绝"
      ]
    },
    {
      "dot": "rose",
      "title": "收口与降级",
      "items": [
        "结构修复 1 次后强制 finish_answer 收口",
        "ProviderError / 预算耗尽 / 超时统一走降级收口",
        "降级不伪造事实，只说明未覆盖并给人工入口"
      ]
    }
  ]
