  "cards": [
    {
      "dot": "cyan",
      "title": "两端职责",
      "items": [
        "用户端：逛店 / 分类与搜索 / 商品详情 / 购物车 / 结算 / 订单 / 导购浮层与独立页",
        "管理端：商品、订单、用户、优惠券、知识库、人工客服与 AI 资产页",
        "两端各自独立的请求层与登录入口；nginx 按 / 与 /admin/ 分流"
      ]
    },
    {
      "dot": "amber",
      "title": "鉴权与会话",
      "items": [
        "前端不存 token：Java 侧走 Sa-Token Cookie（withCredentials）",
        "导购侧写操作带 X-CSRF-Token，会话来自 GET /api/assistant/session",
        "网关 901/401 → 前端重新握手或跳登录；管理端另有敏感操作确认头"
      ]
    },
    {
      "dot": "emerald",
      "title": "「问这件」聚焦",
      "items": [
        "商品页 consultProduct 写入会话级卡片，浮层与独立页共享",
        "每条消息带 focus_mode=PRODUCT + product_id + sku_key",
        "「改问全店」切回 GLOBAL，服务端据此钉在单商品或全店语料"
      ]
    },
    {
      "dot": "violet",
      "title": "导购事件流",
      "items": [
        "SSE over fetch：same-origin 凭证 + Last-Event-ID 游标，100s 超时",
        "断线重连只回放已持久化事件，不重启也不确认运行",
        "提案确认卡片单独拉取实时订单/条目展示，与事件流解耦"
      ]
    }
  ]
