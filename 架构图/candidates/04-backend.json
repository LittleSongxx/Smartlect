  "cards": [
    {
      "dot": "cyan",
      "title": "服务与库",
      "items": [
        "8 个业务服务各连自己的 schema（smartlect_* 八个库）",
        "迁移由 Flyway 管理，每服务一份 baseline",
        "admin 是 BFF：跨库统计视图 + Feign 聚合 order/user 数据"
      ]
    },
    {
      "dot": "amber",
      "title": "内部调用",
      "items": [
        "服务间只走 /internal/** Feign，内部令牌 X-Internal-Token 常量时间校验",
        "order 是编排者：扣库存、券预占、建支付单、清购物车都经内部接口",
        "禁止跨库直连；价格与库存不在任何缓存里当权威"
      ]
    },
    {
      "dot": "emerald",
      "title": "鉴权",
      "items": [
        "网关校验登录态（读 Redis 的 token 键），不再向下游下发身份头",
        "服务端 @SaCheckLogin / @SaCheckPermission 注解兜底",
        "用户端 token 与管理端 adminToken 两套 StpLogic，互不通用"
      ]
    },
    {
      "dot": "violet",
      "title": "异步与一致性",
      "items": [
        "Outbox 本地消息表同事务落库，提交后再投递并等发布确认",
        "延迟队列驱动支付超时关单、自动确认收货与模拟发货",
        "退款走 Saga 状态机 + MQ 回补库存；补偿台账支持自动与人工重放"
      ]
    }
  ]
}