  "cards": [
    {
      "dot": "cyan",
      "title": "派发契约",
      "items": [
        "task_dispatch 只接受 1–3 个任务，理由限 parallel / isolation / deep_chain",
        "每个子代理 25s 超时，单个失败不拖垮整批",
        "子代理上限 6 步（recursion_limit=12），只回文本"
      ]
    },
    {
      "dot": "amber",
      "title": "确定性路由",
      "items": [
        "按关键词路由到三个档位：order-reader / comparator / retrieval-scout",
        "工具集合是只读并集，子代理不能下单、不能改状态",
        "路由结果作为 decision 事件留痕"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享预算",
      "items": [
        "子代理模型调用与工具调用都记在主 run 的预算上",
        "模型 6 次 / 工具 10 次是整轮上限，不是每代理",
        "超预算的子任务标记失败并如实披露"
      ]
    },
    {
      "dot": "rose",
      "title": "合并与披露",
      "items": [
        "compose_results 输出 ✓/✗ 状态、路由档位与耗时",
        "incomplete_tasks 显式披露，模型不得掩盖失败",
        "完整结果留在调用账本，模型只看投影"
      ]
    }
  ]
