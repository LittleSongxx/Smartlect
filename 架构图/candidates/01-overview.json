  "cards": [
    {
      "dot": "cyan",
      "title": "入口与鉴权",
      "items": [
        "用户端 token 与管理端 adminToken 双账号体系，网关统一校验登录态",
        "服务端 @SaCheckLogin / @SaCheckPermission 注解兜底",
        "/internal/** 仅限 X-Internal-Token 内部调用"
      ]
    },
    {
      "dot": "amber",
      "title": "交易权威在 Java",
      "items": [
        "下单、支付、退款、库存、发券只由 Java 服务落库",
        "模型可以建议，不能成交；确认动作由人点击触发",
        "价格与库存不进向量，每次向交易服务重新查询"
      ]
    },
    {
      "dot": "emerald",
      "title": "检索与知识",
      "items": [
        "知识先发布才进检索；撤回后不再被新的回答引用",
        "ES BM25 ∥ Qdrant dense → RRF 融合 → 重排取前 8",
        "答复带引用，出答前复验引用仍可见"
      ]
    },
    {
      "dot": "violet",
      "title": "一致性",
      "items": [
        "单库本地事务 + Outbox 本地消息表，事务提交后再投递",
        "库存与券用条件 UPDATE 防超卖，业务键幂等记录防重复",
        "延迟队列驱动支付超时/自动确认，定时对账与补偿台账兜底"
      ]
    }
  ]
