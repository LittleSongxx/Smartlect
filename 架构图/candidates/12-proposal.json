  "cards": [
    {
      "dot": "cyan",
      "title": "提案状态机",
      "items": [
        "PROPOSED → CONFIRMED / REJECTED / EXPIRED → EXECUTING → SUCCEEDED / FAILED / UNKNOWN",
        "版本号与决策版本双重校验，重复确认不会二次执行",
        "拒绝或过期后提案不再可执行"
      ]
    },
    {
      "dot": "amber",
      "title": "人点确认才成交",
      "items": [
        "确认端点要求用户身份 + orders:write 权限",
        "人工客服接管中的会话拒绝确认（human_control_active）",
        "模型只生成提案，落单动作由用户点击触发"
      ]
    },
    {
      "dot": "emerald",
      "title": "幂等地打到 Java",
      "items": [
        "提案携带 idempotency_key，与 Java 侧请求幂等账本对齐",
        "重放返回同一结果（Idempotency-Replayed）",
        "下单走 createConfirmed（报价单二次确认），金额以分为单位"
      ]
    },
    {
      "dot": "rose",
      "title": "未知态恢复",
      "items": [
        "EXECUTING/UNKNOWN 状态只复核（recover_only），不重复扣款",
        "支付前金额不一致 → 409 RECONFIRM_REQUIRED，回卡片重确认",
        "支付成功由 pay 的 Outbox 事件驱动 order 状态机"
      ]
    }
  ]
