  "cards": [
    {
      "dot": "cyan",
      "title": "用户端链路",
      "items": [
        "Cookie token 经网关查 Redis token:login:token:{t}",
        "通过后注入 X-User-Id 与 X-User-Token-Verified",
        "业务服务再用 @SaCheckLogin 做注解级校验"
      ]
    },
    {
      "dot": "emerald",
      "title": "管理端链路",
      "items": [
        "adminToken 查 adminToken:login:token:{t}（StpAdminLogic）",
        "X-Admin-Token-Verified + AdminSecurityContext 注入",
        "角色权限由 SmartlectStpInterface 从 session 加载"
      ]
    },
    {
      "dot": "rose",
      "title": "三道防线",
      "items": [
        "网关剥离客户端伪造的 X-User-Id 等身份头",
        "/internal/** 统一校验 X-Internal-Token（AI 助手与内部调用）",
        "写操作前端先取 CSRF nonce，后端校验 X-CSRF-Token"
      ]
    },
    {
      "dot": "violet",
      "title": "助手身份桥",
      "items": [
        "IdentityBridge 把 cookie POST 到 user /internal/identity/introspect",
        "访客走签名只读证明，无第二套登录库",
        "901/401 统一触发前端登出与会话刷新"
      ]
    }
  ]
