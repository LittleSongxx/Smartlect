  "cards": [
    {
      "dot": "rose",
      "title": "不可绕过的确认",
      "items": [
        "模型没有任何 approve/execute 工具",
        "提案绑定 quoteId 与确认金额，落单时 Java 复核",
        "确认前必须完成 display 核对，否则前端禁用按钮"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态机",
      "items": [
        "PROPOSED → CONFIRMED/REJECTED（乐观版本并发控制）",
        "CONFIRMED → EXECUTING → SUCCEEDED/FAILED/UNKNOWN",
        "过期提案 410，唯一出路是重新咨询生成"
      ]
    },
    {
      "dot": "amber",
      "title": "三类写操作",
      "items": [
        "下单：v2/createConfirmed 携带报价上下文",
        "取消/退款：v2/executeAction（金额须等于剩余可退）",
        "支付：mock 即时完成，live 只取链接由用户自助"
      ]
    }
  ]
