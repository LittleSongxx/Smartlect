    {
      "dot": "rose",
      "title": "先发布才可检索",
      "items": [
        "候选 SQL 只取 status=PUBLISHED 且在有效期与 ACL 内",
        "撤回即时生效：旧版置 WITHDRAWN 并 bump revision",
        "缓存键含目录 revision，发布后旧缓存自然失效"
      ]
    },
    {
      "dot": "emerald",
      "title": "双写与降级",
      "items": [
        "有 embedding key：异步作业双写 ES 与 Qdrant，可续跑重试",
        "无 key：同步发布，检索退化 BM25-only",
        "ES 不可用时回退内存 jieba 分词"
      ]
    },
    {
      "dot": "violet",
      "title": "混检质量",
      "items": [
        "BM25 与 ANN 并行召回，RRF 融合不偏爱单后端",
        "vendor 重排失败或慢时按滑动窗口降权",
        "后端健康度参与打分，引用必须命中可见块"
      ]
    }
