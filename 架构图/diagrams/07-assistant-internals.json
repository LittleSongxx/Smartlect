  "cards": [
    {
      "dot": "cyan",
      "title": "端点面",
      "items": [
        "用户面 /api/assistant：对话、SSE 事件重放、提案、支付查询",
        "管理面 /admin-api/assistant：知识发布、模型配置、提示词、run 浏览",
        "MCP JSON-RPC 只读工具面与 Prometheus /metrics"
      ]
    },
    {
      "dot": "emerald",
      "title": "有界会话",
      "items": [
        "MySQL 租约互斥（claim_run + 心跳续期）",
        "预算：模型 ≤6、工具 ≤10、检索 ≤2、90 秒硬界",
        "checkpointer 内存或 Postgres，图状态与租约分离"
      ]
    },
    {
      "dot": "rose",
      "title": "工具五层设防",
      "items": [
        "allowed → RBAC → Pydantic strict → 幂等台账 → gen_ai_span",
        "写类工具仅生成提案，无任何 approve/execute 权限",
        "观察投影上限 6500 字节，防上下文膨胀"
      ]
    },
    {
      "dot": "violet",
      "title": "检索与模型",
      "items": [
        "候选仅 status=PUBLISHED 且 ACL 可见；缓存键含目录 revision",
        "rerank 走供应商 gte-rerank-v2，后端故障滑动窗口降权",
        "模型白名单 qwen3.7-plus / glm-5.3，端点限百炼与智谱"
      ]
    }
  ]
