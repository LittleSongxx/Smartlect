  "cards": [
    {
      "dot": "cyan",
      "title": "网关路由",
      "items": [
        "图为四个主要入口；user/product/stock/cart/coupon 走同一 lb:// 模式",
        "/api/assistant 与 /admin-api/assistant 反代到 Python 18000",
        "/admin-api/** 其余由 admin 兜底路由",
        "admin 看板另经 Feign 聚合 product/order/user（图面省略，见说明页）"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据层（每服务独立分库）",
      "items": [
        "MySQL 8：smartlect_user/product/stock/cart/order/pay/coupon/admin + growth",
        "Redis：Sa-Token 会话、商品布隆、秒杀 Lua、支付幂等",
        "RabbitMQ 拓扑在 common 统一声明（见交易时序图）"
      ]
    },
    {
      "dot": "violet",
      "title": "内部信任",
      "items": [
        "/internal/** 由 InternalApiAuthFilter 校验 X-Internal-Token",
        "AI 助手所有 Java 调用带 X-Smartlect-User-Id 与 Idempotency-Key",
        "cart 加购时另经 Feign 校验 product/stock（图中省略）"
      ]
    },
    {
      "dot": "amber",
      "title": "smartlect-common",
      "items": [
        "统一响应/异常、MQ 拓扑与可靠发送（outbox）",
        "Sa-Token 双账号体系与拦截器配置",
        "Redisson 分布式锁、限流注解、内部 API 鉴权过滤器"
      ]
    }
  ]
