  "cards": [
    {
      "dot": "cyan",
      "title": "端口与隔离",
      "items": [
        "所有容器端口仅发布到 127.0.0.1（dev 映射 Redis 16379 / Nacos 18848）",
        "Nginx 是唯一公网入口，HTTP 全部 301 到 HTTPS",
        "MySQL/Redis/RabbitMQ/Nacos 均设 mem_limit 与 healthcheck"
      ]
    },
    {
      "dot": "emerald",
      "title": "进程形态",
      "items": [
        "Web 双应用与 Java 8 服务、Python 助手都是宿主机进程",
        "数据库账号分库分账号（含 flyway、nacos、growth 专用）",
        "可选 Postgres 16 容器（profile）作为 LangGraph checkpointer"
      ]
    },
    {
      "dot": "amber",
      "title": "运维",
      "items": [
        "GitHub Actions CI：lint + 测试 + 构建检查",
        "证书由 certbot.timer 自动续期",
        "compose 卷持久化 mysql/redis/rabbit/es/qdrant 数据"
      ]
    }
  ]
