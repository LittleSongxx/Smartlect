  "cards": [
    {
      "dot": "rose",
      "title": "为什么用 Lua",
      "items": [
        "库存余量与用户限购在同一脚本内原子判定",
        "超卖不可能：reserve_v1 失败即整体回滚",
        "抢购 QPS 另有 Redis 计数限流兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条出路",
      "items": [
        "支付成功 → pay.success 队列核销，占位转正式",
        "15 分钟未付 → pay.timeout 死信 → rollback_v1 释放占位",
        "订单取消与券释放解耦在两个监听器"
      ]
    },
    {
      "dot": "amber",
      "title": "运营工具",
      "items": [
        "warmupRushStock 活动前把库存同步进 Redis",
        "reconcileRushStock 事后对账修正漂移",
        "sweep_dangling 清理悬挂占位"
      ]
    }
  ]
