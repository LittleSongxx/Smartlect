  "cards": [
    {
      "dot": "cyan",
      "title": "三条终止出路",
      "items": [
        "带引用答复：answer 守卫通过后 COMPLETED",
        "待确认提案：propose_order 只落提案，等人点确认",
        "转人工：request_handoff 建工单后结束本轮"
      ]
    },
    {
      "dot": "rose",
      "title": "硬边界",
      "items": [
        "预算耗尽 / 90 秒到点立即收口，不续借",
        "非 live 模式不进图，控制器直接确定性答复",
        "answer 校验失败仅允许一次修复轮"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么稳",
      "items": [
        "MySQL 租约互斥，同一会话同时只有一个 run",
        "SSE 断线可按 Last-Event-ID 重放事件",
        "工具幂等台账防重复执行"
      ]
    }
