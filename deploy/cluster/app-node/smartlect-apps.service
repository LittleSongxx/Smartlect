# 应用副本节点的开机单元（node2/node3）。由 deploy/cluster/scripts/sync-app-node.sh 安装到
# /etc/systemd/system/smartlect-apps.service。
#
# 与 node1 的单元两处不同：
#   1) 副本节点没有 smartlect-infra（中间件在别的机器上），改为等远程文件系统就绪——
#      上传目录没挂上就起 user 服务会让文件接口直接写本地目录，产生"副本间看不到对方上传"。
#   2) ExecStartPre 轮询等集群中间件可达。
#
# 为什么必须有 ExecStartPre：Docker 容器的就绪晚于 systemd 单元启动，而本单元是 oneshot
# ——首次检查失败即永久放弃。2026-10-05 扩容重启实测：容器全部自愈、两个副本节点的应用
# 一个都没起来，站点靠 node1 单机扛到人工介入。
[Unit]
Description=Smartlect app replicas (gateway/product/order/user|cart)
After=network-online.target remote-fs.target docker.service
Wants=network-online.target remote-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/smartlect
ExecStartPre=/usr/bin/python3 scripts/runtime.py wait-cluster --timeout 300
ExecStart=/usr/bin/python3 scripts/runtime.py up
ExecStop=/usr/bin/python3 scripts/runtime.py apps-down
TimeoutStartSec=900
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
