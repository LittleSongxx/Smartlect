# node1（应用主节点）的开机单元副本，入库以便评审与重建。
# 服务器上的实装位置：/etc/systemd/system/smartlect-apps.service
#
# 注意 TimeoutStartSec 从 600 提到 900：集群形态下 ExecStartPre 最多等 300s 中间件，
# 之后才是 12 个进程逐个预热，600s 在大盘机器上留的余量不够。
[Unit]
Description=Smartlect apps (9 Java + assistant + web user/admin)
After=network-online.target smartlect-infra.service docker.service
Wants=smartlect-infra.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/smartlect
# 集群形态下还要等对端中间件（rabbit-c2/c3、nacos-c2/c3、sentinel）就绪。
# 单机形态该命令直接放行，不影响回退后的开机流程。
ExecStartPre=/usr/bin/python3 scripts/runtime.py wait-cluster --timeout 300
ExecStart=/usr/bin/python3 scripts/runtime.py up
ExecStop=/usr/bin/python3 scripts/runtime.py apps-down
TimeoutStartSec=900
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
