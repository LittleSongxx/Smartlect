{
  "schema_version": "quality-v2-ads-playbooks-holdout2-v1",
  "split": "holdout2",
  "simulated_not_causal": true,
  "causal_conclusion_supported": false,
  "count_source": "campaign.metrics",
  "forbid": ["summary.payment_conversions", "recommendation_clicks", "GET /admin-api/assistant/ads top-level totals"],
  "playbooks": [
    {
      "playbook_id": "ads-h2-01",
      "kind": "fatigue_click_vs_pacing",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 2000, "cpc_cents": 10}
      ],
      "script": [
        {"op": "probe_rank", "expect_first": "a", "expect_items": 2},
        {"op": "expose", "slot": "a", "count": 3},
        {"op": "probe_rank", "expect_first": "b"},
        {"op": "click", "slot": "a", "count": 1},
        {"op": "probe_rank", "expect_first": "b"}
      ],
      "note": "疲劳复位不等于复位排名：点击把疲劳归 1 但花费使配速乘数 0.9975<1.0，a 仍排 b 后——复合因子判定",
      "expected": {
        "counts": {"impressions": 3, "clicks": 1, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.3333333333333333,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-h2-02",
      "kind": "dual_exhaustion_gate",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 30, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 2000, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 4},
        {"op": "click", "slot": "a", "count": 3},
        {"op": "reject", "http": "click", "slot": "a", "error": "ads_not_active"},
        {"op": "probe_status", "slot": "a", "expect_status": "EXHAUSTED", "expect_pause_reason": "budget_exhausted"},
        {"op": "probe_rank", "expect_first": "b", "expect_items": 1}
      ],
      "note": "双活动下小额预算耗尽：EXHAUSTED 转移 + 409 + 从候选消失，b 独存",
      "expected": {
        "counts": {"impressions": 4, "clicks": 3, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.75,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-h2-03",
      "kind": "creative_granular_click_reset",
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10, "creatives": ["a1", "a2"]}
      ],
      "script": [
        {"op": "probe_rank", "expect_first": "a1", "expect_items": 2},
        {"op": "expose", "slot": "a1", "count": 3},
        {"op": "probe_rank", "expect_first": "a2"},
        {"op": "click", "slot": "a1", "count": 1},
        {"op": "probe_rank", "expect_first": "a1"}
      ],
      "note": "素材粒度疲劳复位：点击 a1 后其疲劳归 1（a2 未看疲劳 1，共享活动配速相等）平手按素材 id 序 a1 复位",
      "expected": {
        "counts": {"impressions": 3, "clicks": 1, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.3333333333333333,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-h2-04",
      "kind": "fatigue_viewer_isolation",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 2000, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 2},
        {"op": "probe_rank", "expect_first": "b"},
        {"op": "probe_rank", "expect_first": "a", "as_actor": "user_b"}
      ],
      "note": "观众隔离复测（新流量形状）：user_a 疲劳不影响 user_b 的平手排序",
      "expected": {
        "counts": {"impressions": 2, "clicks": 0, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.0,
        "CVR": null
      }
    },
    {
      "playbook_id": "ads-h2-05",
      "kind": "impressions_only",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures"],
      "traffic": {"impressions": 12, "clicks": 0, "payments": 0},
      "expected": {
        "counts": {"impressions": 12, "clicks": 0, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.0,
        "CVR": null
      }
    },
    {
      "playbook_id": "ads-h2-06",
      "kind": "clicks_no_payment",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures", "clicks"],
      "traffic": {"impressions": 9, "clicks": 2, "payments": 0},
      "expected": {
        "counts": {"impressions": 9, "clicks": 2, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.2222222222222222,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-h2-07",
      "kind": "attributed_payment",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures", "clicks", "confirm_other_sku", "mock_pay"],
      "traffic": {"impressions": 5, "clicks": 1, "payments": 1},
      "buy": "other_sku",
      "note": "点 A 买 B 归因复测（新流量形状）",
      "expected": {
        "counts": {"impressions": 5, "clicks": 1, "payment_conversions": 1, "unknown_payments": 0},
        "CTR": 0.2,
        "CVR": 1.0
      }
    }
  ]
}
