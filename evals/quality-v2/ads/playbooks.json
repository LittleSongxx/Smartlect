{
  "schema_version": "quality-v2-ads-playbooks-v2",
  "split": "development",
  "simulated_not_causal": true,
  "causal_conclusion_supported": false,
  "count_source": "campaign.metrics",
  "forbid": ["summary.payment_conversions", "recommendation_clicks", "GET /admin-api/assistant/ads top-level totals"],
  "playbooks": [
    {
      "playbook_id": "ads-d-01",
      "kind": "impressions_only",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures"],
      "traffic": {"impressions": 8, "clicks": 0, "payments": 0},
      "expected": {
        "counts": {"impressions": 8, "clicks": 0, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.0,
        "CVR": null
      }
    },
    {
      "playbook_id": "ads-d-02",
      "kind": "clicks_no_payment",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures", "clicks"],
      "traffic": {"impressions": 10, "clicks": 3, "payments": 0},
      "expected": {
        "counts": {"impressions": 10, "clicks": 3, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.3,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-d-03",
      "kind": "attributed_payment",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures", "clicks", "confirm_same_sku", "mock_pay"],
      "traffic": {"impressions": 6, "clicks": 2, "payments": 1},
      "buy": "ad_sku",
      "expected": {
        "counts": {"impressions": 6, "clicks": 2, "payment_conversions": 1, "unknown_payments": 0},
        "CTR": 0.3333333333333333,
        "CVR": 0.5
      }
    },
    {
      "playbook_id": "ads-d-04",
      "kind": "attributed_payment",
      "steps": ["create_campaign", "grant", "activate_campaign", "activate_creative", "exposures", "clicks", "confirm_other_sku", "mock_pay"],
      "traffic": {"impressions": 8, "clicks": 2, "payments": 1},
      "buy": "other_sku",
      "note": "点广告A买B：付款仍应归因到该活动并计入 payment_conversions",
      "expected": {
        "counts": {"impressions": 8, "clicks": 2, "payment_conversions": 1, "unknown_payments": 0},
        "CTR": 0.25,
        "CVR": 0.5
      }
    },
    {
      "playbook_id": "ads-d-05",
      "kind": "organic_payment",
      "steps": ["confirm_without_campaign", "mock_pay"],
      "traffic": {"impressions": 0, "clicks": 0, "payments": 1},
      "note": "未挂活动的付款进 unknown_attribution，不得塞进任何活动的 CVR 分子",
      "expected": {
        "counts": {"impressions": 0, "clicks": 0, "payment_conversions": 0, "unknown_payments": 1},
        "CTR": null,
        "CVR": null
      }
    },
    {
      "playbook_id": "ads-d-06",
      "kind": "fatigue_reorder",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 2000, "cpc_cents": 10}
      ],
      "script": [
        {"op": "probe_rank", "expect_first": "a", "expect_items": 2},
        {"op": "expose", "slot": "a", "count": 3},
        {"op": "probe_rank", "expect_first": "b"},
        {"op": "expose", "slot": "b", "count": 1},
        {"op": "click", "slot": "a", "count": 1},
        {"op": "click", "slot": "b", "count": 1},
        {"op": "probe_rank", "expect_first": "a"}
      ],
      "note": "疲劳三段：同 SKU 双活动 relevance 打平——新鲜平手按 id 序 a 先；a 被 3 次忽略后 1/(1+3) 降权 b 先；双侧等花费点击后疲劳归 1 平手 a 先（点击=兴趣不是疲劳）",
      "expected": {
        "counts": {"impressions": 4, "clicks": 2, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.5,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-d-07",
      "kind": "fatigue_viewer_isolation",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 2000, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 3},
        {"op": "probe_rank", "expect_first": "b"},
        {"op": "probe_rank", "expect_first": "a", "as_actor": "user_b"}
      ],
      "note": "疲劳按观众隔离：user_a 在 a 上疲劳后 b 先；user_b 无观看史保持平手 a 先",
      "expected": {
        "counts": {"impressions": 3, "clicks": 0, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.0,
        "CVR": null
      }
    },
    {
      "playbook_id": "ads-d-08",
      "kind": "pacing_partial_spend",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 100, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 100, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 5},
        {"op": "click", "slot": "a", "count": 5},
        {"op": "probe_rank", "expect_first": "b", "expect_items": 2}
      ],
      "note": "配速：a 花掉一半预算（pacing 0.5 → 乘数 0.75，点击使疲劳=1）仍可投但排在满额 b 之后",
      "expected": {
        "counts": {"impressions": 5, "clicks": 5, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 1.0,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-d-09",
      "kind": "budget_exhaustion_gate",
      "campaigns": [
        {"slot": "a", "budget_cents": 50, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 8},
        {"op": "click", "slot": "a", "count": 5},
        {"op": "reject", "http": "click", "slot": "a", "error": "ads_not_active"},
        {"op": "reject", "http": "exposure", "slot": "a", "error": "ads_not_active"},
        {"op": "probe_status", "slot": "a", "expect_status": "EXHAUSTED", "expect_pause_reason": "budget_exhausted"},
        {"op": "probe_rank", "expect_first": null, "expect_items": 0}
      ],
      "note": "预算耗尽：预算 50/cpc 10——第 5 击扣满时 click 事务自动把活动转为 EXHAUSTED/budget_exhausted，此后点击与新增曝光一律 409 ads_not_active，活动从推荐候选消失",
      "expected": {
        "counts": {"impressions": 8, "clicks": 5, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.625,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-d-10",
      "kind": "pacing_near_exhaustion",
      "same_sku": true,
      "campaigns": [
        {"slot": "a", "budget_cents": 100, "cpc_cents": 10},
        {"slot": "b", "budget_cents": 100, "cpc_cents": 10}
      ],
      "script": [
        {"op": "expose", "slot": "a", "count": 10},
        {"op": "click", "slot": "a", "count": 9},
        {"op": "probe_rank", "expect_first": "b", "expect_items": 2},
        {"op": "click", "slot": "a", "count": 1},
        {"op": "probe_rank", "expect_first": "b", "expect_items": 1}
      ],
      "note": "近耗尽配速到除名：a 花 90/100（乘数 0.55）仍在投但殿后；最后一击扣满后从候选过滤（delivery_candidates 门 remaining>=cpc）",
      "expected": {
        "counts": {"impressions": 10, "clicks": 10, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 1.0,
        "CVR": 0.0
      }
    },
    {
      "playbook_id": "ads-d-11",
      "kind": "fatigue_creative_granularity",
      "campaigns": [
        {"slot": "a", "budget_cents": 2000, "cpc_cents": 10, "creatives": ["a1", "a2"]}
      ],
      "script": [
        {"op": "probe_rank", "expect_first": "a1", "expect_items": 2},
        {"op": "expose", "slot": "a1", "count": 3},
        {"op": "probe_rank", "expect_first": "a2"}
      ],
      "note": "疲劳按素材粒度：同活动两条素材同 SKU——新鲜平手按素材 id 序 a1 先；a1 被忽略 3 次后 a2 顶上（疲劳挂在 creative 而非 campaign）",
      "expected": {
        "counts": {"impressions": 3, "clicks": 0, "payment_conversions": 0, "unknown_payments": 0},
        "CTR": 0.0,
        "CVR": null
      }
    }
  ]
}
