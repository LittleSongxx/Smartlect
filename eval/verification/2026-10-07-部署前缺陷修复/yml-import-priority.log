# 证据 2：spring.config.import 与声明它的文档之间的优先级
# 生成时间：2026-10-07T04:03:15+08:00
# 场景：application.yml 定义 foo=local-value 并 import imported.yml；imported.yml 定义 foo=imported-value
# 运行：java -cp <boot-3.5.16 全家桶 + snakeyaml-2.4> probe.PrioApp

PROBE | foo(local与import都定义) = imported-value
PROBE | onlyImp(仅import定义)   = from-imported
PROBE | spring.config.import    = optional:classpath:imported.yml

# 结论：foo=imported-value —— imported 文档优先于声明它的文档，
#       即 Nacos 的值会覆盖本地 application.yml 的同名键（与批次四记录里
#       「本地保留作 fallback、运行时优先从 Nacos 读取」一致，方向是 Nacos 覆盖本地）。
